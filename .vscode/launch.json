// A launch configuration that compiles the extension and then opens it inside a new window
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Extension",
      "type": "extensionHost",
      "request": "launch",
      // Other vscode-sftp forks register the same sftp.* settings, commands and
      // views, so whichever loads first wins; keep them out of the dev host.
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extension=Natizyskunk.sftp",
        "--disable-extension=suntobright.vscode-sftp"
      ],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: dev"
    },
    {
      "name": "Launch Extension (other extensions disabled)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "--disable-extensions"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: dev"
    }
  ]
}
