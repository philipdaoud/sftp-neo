// Builds the extension with webpack in watch mode before launching it.
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "silent" },
      "problemMatcher": {
        "owner": "webpack",
        "fileLocation": "absolute",
        "severity": "error",
        "pattern": [
          {
            "regexp": "^\\[tsl\\] (ERROR|WARNING) in (.*)\\((\\d+),(\\d+)\\)$",
            "severity": 1,
            "file": 2,
            "line": 3,
            "column": 4
          },
          {
            "regexp": "^\\s*(TS\\d+:.*)$",
            "message": 1
          }
        ],
        // webpack 5 prints "asset …" when a (re)build starts emitting and
        // "webpack x.y.z compiled …" when it is done; the launch waits for the latter.
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^(asset |\\[webpack-cli\\]|webpack is watching)",
          "endsPattern": "^webpack .* compiled"
        }
      }
    }
  ]
}
